# Production domain, no trailing slash. Drives canonical/hreflang/sitemap/OG URLs.
# While unset, robots.txt blocks all crawlers.
NEXT_PUBLIC_SITE_URL=https://www.example.si

# Online booking (Calendly). Leave empty to show "booking coming soon" + Instagram DM.
# General booking link (a single event type, or the Calendly profile page):
NEXT_PUBLIC_CALENDLY_URL=
# Optional: one event type per length. The booking page picks the one matching the
# length chosen in the price calculator; falls back to NEXT_PUBLIC_CALENDLY_URL.
NEXT_PUBLIC_CALENDLY_URL_30=
NEXT_PUBLIC_CALENDLY_URL_60=
NEXT_PUBLIC_CALENDLY_URL_90=
